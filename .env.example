DATABASE_URL=
ATLAS_API_KEY=
EMAIL_SENDER_CLASS=src.services.email.GmailSender
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=30
EMAIL_RATE_LIMIT_PER_MINUTE=5
DIAS_CRITICO=7
DIAS_ATENCAO=30
ATLAS_GESTOR_NOME=Gestor ATLAS
ATLAS_EMPRESA_NOME=Empresa ATLAS
# Chave dedicada para criptografar dados sensiveis de conexao do cliente
# (API/webhook de sistema). Obrigatoria fora de DEBUG=false; em desenvolvimento
# cai para o SECRET_KEY do Django se nao for informada.
ATLAS_SECRETS_KEY=
# Origens autorizadas a consumir a API pelo navegador, separadas por virgula.
# Em producao, informe a origem real da SPA no lugar do host de desenvolvimento.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Autenticacao por JWT (djangorestframework-simplejwt).
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# Usuario operador criado por `manage.py criar_operador` (fallback quando nao
# sao passados --username/--password/--email).
OPERADOR_USERNAME=
OPERADOR_PASSWORD=
OPERADOR_EMAIL=
# Camada de transporte (HTTPS/TLS). Em producao, ative com TLS terminado no
# proxy/infra e lista REAL de ALLOWED_HOSTS.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
